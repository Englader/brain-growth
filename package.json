{
  "name": "brain-growth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adaptive, bilingual (EN/MK) math game for ages 5-14. Static site, offline-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node sim/run.ts",
    "gen:skill-doc": "vite-node scripts/gen-skill-doc.ts",
    "gen:audio-script": "vite-node scripts/gen-audio-script.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.3",
    "fontkit": "^2.0.4",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
